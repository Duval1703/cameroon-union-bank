{
  "expo": {
    "name": "Cameroon Union Bank",
    "slug": "cameroon-union-bank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#002853"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cameroonunionbank.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cameroon Union Bank uses the camera for identity verification and secure document capture.",
        "NSPhotoLibraryUsageDescription": "Cameroon Union Bank accesses your photo library to select identity and financial documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#002853"
      },
      "package": "com.cameroonunionbank.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Cameroon Union Bank to use the microphone for assisted financial records.",
          "speechRecognitionPermission": "Allow Cameroon Union Bank to convert spoken financial records into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "06595bf0-b8ed-434f-837b-05ab619c0f16"
      }
    },
    "owner": "duval1703"
  }
}
