    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "expo": "~52.0.46",
    "expo-asset": "~10.0.10",
    "expo-blur": "~14.0.3",
    "expo-camera": "~16.0.18",
