{
  "expo": {
    "name": "MboaTrust AI",
    "slug": "mboatrust-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E4B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mboatrust.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "MboaTrust AI uses the camera to capture payment receipts for verification.",
        "NSPhotoLibraryUsageDescription": "MboaTrust AI accesses your photo library to select payment receipts for verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E4B"
      },
      "package": "com.mboatrust.ai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow MboaTrust AI to use the microphone for voice inventory records.",
          "speechRecognitionPermission": "Allow MboaTrust AI to convert spoken inventory records into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "06595bf0-b8ed-434f-837b-05ab619c0f16"
      }
    },
    "owner": "duval1703"
  }
}
