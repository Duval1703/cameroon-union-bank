# CUB Backend Environment Variables

# Database Configuration
DATABASE_URL=postgresql://cub_user:your_password_here@localhost:5432/cub_database

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Configuration
API_HOST=0.0.0.0
API_PORT=8003
DEBUG=True

# CORS - Add your frontend URLs
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://192.168.192.1:8081

# SMS Collection Agent
SMS_AGENT_URL=http://localhost:8004

# Inventory OCR
# When set, inventory photo OCR is sent to the self-hosted PaddleOCR service.
INVENTORY_OCR_SERVICE_URL=http://178.128.164.89
INVENTORY_OCR_SERVICE_KEY=your-paddleocr-service-key
INVENTORY_OCR_ENGINE=tesseract

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@cub.cm
