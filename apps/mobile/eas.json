{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cub-api.onrender.com",
        "EXPO_PUBLIC_DATA_AGENT_URL": "https://cub-data-collection.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cub-api.onrender.com",
        "EXPO_PUBLIC_DATA_AGENT_URL": "https://cub-data-collection.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cub-api.onrender.com",
        "EXPO_PUBLIC_DATA_AGENT_URL": "https://cub-data-collection.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {}
    }
  }
}
